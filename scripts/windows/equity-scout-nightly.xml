<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>equity-scout nightly chain (training + auto-depot) — starts WSL if needed and runs the guarded wrapper (installed by v10.1 plan; remove with: schtasks /delete /tn equity-scout-nightly)</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-07-21T02:40:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek><Tuesday/><Wednesday/><Thursday/><Friday/><Saturday/></DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <StartWhenAvailable>true</StartWhenAvailable>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- Without this the task cannot WAKE a sleeping box, only run once something else woke
         it - which made the 02:40 slot dependent on the machine happening to be awake
         (measured 2026-08-10: WakeToRun was false here while the session task had it true).
         StartWhenAvailable only catches up AFTER a wake, so it is not a substitute. Wake
         timers are enabled on AC and off on battery by Windows policy; that stays. -->
    <WakeToRun>true</WakeToRun>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wsl.exe</Command>
      <Arguments>-d Ubuntu -u nicosutheimer -- /home/nicosutheimer/private/equity-scout/scripts/run_nightly_guarded.sh windows</Arguments>
    </Exec>
  </Actions>
</Task>
