# Copy to .env and fill in — every variable is optional; without it the pipeline
# degrades honestly (inbox-only pitches, stdout digest, unconfigured 13F collector).
# Never commit real values.

# Telegram copilot (pitches, evidence alerts, one-tap decisions)
COPILOT_TG_BOT_TOKEN=
COPILOT_TG_CHAT_ID=

# Daily e-mail digest
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Local LLM for pitch texts / assistant tab
OLLAMA_HOST=
OLLAMA_MODEL=

# SEC EDGAR requires a contact in the User-Agent for 13F fetches, e.g. "Jane Doe (jane@example.org)"
EDGAR_USER_AGENT=

# Alpaca PAPER keys for the session lane (free tier: IEX data + paper trading).
# PAPER ONLY — src/equity_scout/alpaca_broker.py hardcodes the paper host and has no switch
# that could point it at live money. Note this repo has NO python-dotenv: the shell sources
# .env, so a bare `python scripts/...` sees nothing. Use:
#   set -a && . ./.env && set +a && .venv/bin/python scripts/...
# Without these keys the session lane degrades to the delayed yfinance path and says so.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
